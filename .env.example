# Скопируй этот файл в .env и заполни своими значениями.
# .env НЕ должен попадать в git — он уже в .gitignore.

# Сгенерировать новый секретный ключ можно командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=замени-меня-на-случайную-строку

DJANGO_DEBUG=False

# Домен(ы) через запятую, без http:// — например: timetable.iss-astana.kz,www.timetable.iss-astana.kz
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN

# То же самое, но с https:// впереди — нужно для защиты от CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN

# Путь к файлу базы данных внутри контейнера (не менять, если используешь docker-compose как есть)
DJANGO_DB_PATH=/app/data/db.sqlite3
